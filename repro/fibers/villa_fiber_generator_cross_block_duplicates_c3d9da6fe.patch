+def along_y(x, z, y0=10.0, y1=86.0):
+    """ZYX points of a straight horizontal-family spline along y."""
+    y = np.arange(y0, y1 + 0.25, 0.5)
+    return np.stack([np.full_like(y, z), y, np.full_like(y, x)], axis=1)
+
+
+def two_blocks(tmp_path, zs, shift):
+    """Fibres along y at global x 150, inside both blocks' read regions; block 1's copies ``shift`` voxels off in z."""
+    stitcher = Stitcher(tmp_path)
+    try:
+        stitcher.add_block("block-0", [0, 0, 0], [192, 96, 96], [("H", along_y(150, z)) for z in zs],
+                           (np.zeros(3), np.array([160, 96, 96])))
+        stitcher.add_block("block-1", [128, 0, 0], [192, 96, 96], [("H", along_y(22, z + shift)) for z in zs],
+                           (np.array([160, 0, 0]), np.array([320, 96, 96])))
+        return stitcher.stitched()
+    finally:
+        stitcher.close()
+
+
+def test_two_blocks_copies_of_a_fiber_along_their_border_are_written_once(tmp_path, monkeypatch):
+    # 0.3 voxel apart: past strict_duplicate's 0.20 median, well inside compare()'s duplicate.
+    assert len(two_blocks(tmp_path / "patched", [48.0], 0.3)) == 1
+    monkeypatch.setattr(catalog, "cross_block_duplicate", lambda a, b: None)
+    assert len(two_blocks(tmp_path / "strict only", [48.0], 0.3)) == 2
+
+
+def test_adjacent_fibers_seen_by_both_blocks_stay_two(tmp_path):
+    # Fibres 2 voxels apart: each block's copy of one is suppressed by the other block's, never the neighbour.
+    stitched = two_blocks(tmp_path, [48.0, 50.0], 0.3)
+    assert len(stitched) == 2
+    assert sorted(round(float(np.median(np.asarray(t["points"])[:, 2]))) for t in stitched) == [48, 50]
