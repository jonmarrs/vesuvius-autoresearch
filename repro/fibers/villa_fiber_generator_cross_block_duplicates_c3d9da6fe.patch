+def cross_block_duplicate(a, b):
+    """``a`` lying along ``b`` where two blocks fitted them: compare()'s duplicate.
+
+    Each block fits its splines to the field it predicted from its own crop, so
+    two blocks' copies of one fibre lie a few tenths of a voxel apart where
+    both read it, outside strict_duplicate. Only sources of different blocks
+    are compared so; adjacent fibres of one block never are.
+    """
+    match = ov.compare(a, b)
+    if match is None or match['kind'] != 'duplicate' or match['contained'] == 'B':
+        return None
+    return dict(crossBlock=True, **match['metrics'])
+
+
