repro/gp_winner/runs/
villa/ink-detection/models/
villa/ink-detection/outputs/

# Agent scratch: SDD ledgers, task briefs, review packages, fix reports.
# Working files, never deliverables. Was assumed ignored and was not.
.superpowers/
# The loop's first-use record of an older incumbent's validation inputs.
/best_model.pt.inputs.json
# The PHerc.1667 ablation checkpoints, when fetched in place (repro/ink_ablation/fetch_checkpoints.sh),
# and the prediction maps and canon previews its ladder scripts cache in the working directory.
/repro/ink_ablation/it[0-5]/
/repro/ink_ablation/preds_*.npz
/repro/ink_ablation/canon_*.jpg
# What the spiral_s1 and scroll1_cubes fetchers write beside themselves when run in place (they were
# run from a copy in the data directory; spiral_s1's inputs alone are ~48 GB). Scripts, documentation,
# spiral-scroll.json and the two input lists the fetchers read stay visible.
/repro/spiral_s1/*
!/repro/spiral_s1/*.sh
!/repro/spiral_s1/*.py
!/repro/spiral_s1/*.md
!/repro/spiral_s1/spiral-scroll.json
!/repro/spiral_s1/patch_dirs.txt
/repro/scroll1_cubes/*
!/repro/scroll1_cubes/*.sh
!/repro/scroll1_cubes/*.py
!/repro/scroll1_cubes/*.md
!/repro/scroll1_cubes/all_cubes.txt
