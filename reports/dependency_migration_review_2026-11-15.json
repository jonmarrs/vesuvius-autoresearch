    "openssl": "OpenSSL 4.0.3 29 Sep 2026",
    "signer": "google.auth.crypt.rsa.RSASigner",
    "checks": [
      "ephemeral 2048-bit RSA PKCS8 PEM load/sign",
      "self-signed X509 PEM roundtrip and certificate-key verification",
      "Google Auth signature roundtrip and tampered message rejection",
      "Google Auth JWT audience/signature verification and wrong audience rejection"
    ],
    "external_requests": false,
    "source_sha256": "a66c1b6764f792c618cb327567927c332c169e933c6b337ad1a297e90bbb4b62",
    "source_lines": [
      "\"\"\"Local, disposable compatibility probe; no account credentials or requests.\"\"\"",
      "",
      "import datetime",
      "import importlib.metadata",
      "import json",
      "",
      "from cryptography import x509",
      "from cryptography.hazmat.backends.openssl.backend import backend",
      "from cryptography.hazmat.primitives import hashes, serialization",
      "from cryptography.hazmat.primitives.asymmetric import rsa",
      "from cryptography.x509.oid import NameOID",
      "from google.auth import crypt, jwt",
      "",
      "key = rsa.generate_private_key(public_exponent=65537, key_size=2048)",
      "pem = key.private_bytes(",
      "    serialization.Encoding.PEM,",
      "    serialization.PrivateFormat.PKCS8,",
      "    serialization.NoEncryption(),",
      ")",
      "name = x509.Name([x509.NameAttribute(NameOID.COMMON_NAME, \"local migration probe\")])",
      "now = datetime.datetime.now(datetime.timezone.utc)",
      "certificate = (",
      "    x509.CertificateBuilder()",
      "    .subject_name(name)",
      "    .issuer_name(name)",
      "    .public_key(key.public_key())",
      "    .serial_number(x509.random_serial_number())",
      "    .not_valid_before(now - datetime.timedelta(minutes=1))",
      "    .not_valid_after(now + datetime.timedelta(minutes=5))",
      "    .sign(key, hashes.SHA256())",
      ")",
      "cert_pem = certificate.public_bytes(serialization.Encoding.PEM)",
      "assert x509.load_pem_x509_certificate(cert_pem).public_key().public_numbers() == (",
      "    key.public_key().public_numbers()",
      ")",
      "signer = crypt.RSASigner.from_string(pem, key_id=\"local-test\")",
      "verifier = crypt.RSAVerifier.from_string(cert_pem)",
      "signature = signer.sign(b\"migration probe\")",
      "assert verifier.verify(b\"migration probe\", signature)",
      "assert not verifier.verify(b\"modified message\", signature)",
      "claims = {\"iss\": \"local-test\", \"aud\": \"migration-test\", \"iat\": int(now.timestamp())}",
      "claims[\"exp\"] = claims[\"iat\"] + 60",
      "token = jwt.encode(signer, claims)",
      "assert jwt.decode(token, certs={\"local-test\": cert_pem}, audience=\"migration-test\") == claims",
      "try:",
      "    jwt.decode(token, certs={\"local-test\": cert_pem}, audience=\"wrong-audience\")",
      "except ValueError:",
      "    pass",
      "else:",
      "    raise AssertionError(\"wrong audience accepted\")",
      "assert type(signer).__module__ == \"google.auth.crypt.rsa\"",
      "print(json.dumps({",
      "    \"status\": \"passed\",",
      "    \"packages\": {p: importlib.metadata.version(p) for p in (",
      "        \"cryptography\", \"google-auth\", \"cffi\", \"typing-extensions\"",
      "    )},",
      "    \"openssl\": backend.openssl_version_text(),",
      "    \"signer\": type(signer).__module__ + \".\" + type(signer).__name__,",
      "    \"checks\": [",
      "        \"ephemeral 2048-bit RSA PKCS8 PEM load/sign\",",
      "        \"self-signed X509 PEM roundtrip and certificate-key verification\",",
      "        \"Google Auth signature roundtrip and tampered message rejection\",",
      "        \"Google Auth JWT audience/signature verification and wrong audience rejection\",",
      "    ],",
      "    \"external_requests\": False,",
      "}, indent=2))"
    ],
