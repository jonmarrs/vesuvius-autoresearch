  "synthetic_cpu_probe": {
    "purpose": "Exercise the real regional CLIs with small random, untrained gated_unet checkpoints and synthetic uint16 CT. These values are not representative memory-capacity results.",
    "source_sha256": "ee3addec9345c1e195e0ce88f7d31f231d239ac44a51f6c010cb78a04477db04",
    "source_lines": [
      "import hashlib",
      "import json",
      "import os",
      "import subprocess",
      "import sys",
      "from pathlib import Path",
      "",
      "import numpy as np",
      "import torch",
      "import zarr",
      "",
      "sys.path[:0] = ['/workspace/vesuvius-repository-audit', '/workspace/vesuvius-repository-audit/src']",
      "from vesuvius_autoresearch.core.model_wrappers import build_inference_model",
      "",
      "root = Path('/tmp/vesuvius-memory-smoke')",
      "root.mkdir(exist_ok=True)",
      "volume = root/'ct.zarr'",
      "values = np.random.default_rng(19).integers(0, 65536, (6, 16, 16), dtype=np.uint16)",
      "zarr.array(values, store=str(volume), chunks=(2, 8, 8), overwrite=True)",
      "checkpoints = []",
      "torch.manual_seed(17)",
      "for index, features in enumerate((4, 8)):",
      "    config = dict(architecture='gated_unet', patch_size=8, num_layers=4, base_feat=features,",
      "                  num_blocks=1, num_heads=1, use_ridges=False, dropout=0.0)",
      "    model = build_inference_model(**config)",
      "    checkpoint = root/f'model{index}.pt'",
      "    torch.save({'config':config, 'model_state_dict':model.state_dict()}, checkpoint)",
      "    checkpoints.append(checkpoint)",
      "",
      "env = dict(os.environ)",
      "env.update(OMP_NUM_THREADS='1', OPENBLAS_NUM_THREADS='1', MKL_NUM_THREADS='1',",
      "           CUDA_VISIBLE_DEVICES='', MPLBACKEND='Agg', MPLCONFIGDIR='/tmp/vesuvius-memory-mpl')",
      "records = {}",
      "for mode in ('single','ensemble'):",
      "    outputs = {}",
      "    for profiled in (False, True):",
      "        stem = mode + ('_profiled' if profiled else '_plain')",
      "        command = [sys.executable, '-m', 'scripts.inference.' + ('predict' if mode=='single' else 'ensemble_predict'),",
      "                   '--uri', str(volume), '--x','0','--y','0','--z','1','--width','12','--height','10',",
      "                   '--stride','4','--artifact_stem',stem,'--output_img',str(root/'out'/f'{stem}.png')]",
      "        if mode=='single': command += ['--checkpoint',str(checkpoints[0]),'--skip_active_learning']",
      "        else: command += ['--checkpoints',*[str(p) for p in checkpoints]]",
      "        if profiled: command += ['--profile_memory']",
      "        run = subprocess.run(command, cwd='/workspace/vesuvius-repository-audit', env=env,",
      "                             capture_output=True, text=True, timeout=120)",
      "        (root/f'{stem}.log').write_text(run.stdout+run.stderr)",
      "        assert run.returncode == 0, run.stdout+run.stderr",
      "        metadata = json.loads((root/'out'/f'{stem}_meta.json').read_text())",
      "        outputs[profiled] = {name:np.load(root/'out'/f'{stem}_{name}.npy') for name in ('ink','fiber')}",
      "        if profiled:",
      "            records[mode] = {'command':command,'memory_profile':metadata['memory_profile'],",
      "                             'model_configs':metadata.get('ensemble_model_configs',[metadata['model_config']]),",
      "                             'inference_recipe':metadata['inference_recipe'],",
      "                             'resource_plan':metadata['resource_plan']}",
      "        else: assert 'memory_profile' not in metadata",
      "    for name in ('ink','fiber'):",
      "        np.testing.assert_array_equal(outputs[False][name],outputs[True][name])",
      "    records[mode]['profiling_preserves_probability_arrays_exactly'] = True",
      "records['checkpoint_sha256'] = {p.name:hashlib.sha256(p.read_bytes()).hexdigest() for p in checkpoints}",
      "records['ct_decoded_sha256'] = hashlib.sha256(values.tobytes()).hexdigest()",
      "(root/'probe.json').write_text(json.dumps(records,indent=2)+'\\n')",
      "print(json.dumps({mode:{'device':records[mode]['memory_profile']['device'],",
      "                        'phases':[o['phase'] for o in records[mode]['memory_profile']['observations']],",
      "                        'unchanged_probabilities':True} for mode in ('single','ensemble')},indent=2))"
    ],
