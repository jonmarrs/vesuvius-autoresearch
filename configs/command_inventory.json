{
  "schema_version": 1,
  "scope": "Reviewed primary command families only. Requirements are declared capability boundaries, not installable extras, complete dependency closures or runtime/readiness checks.",
  "stacks": {
    "stdlib": "Listed mode uses the Python standard library; some commands have heavier modes described in needs.",
    "scientific": "Scientific/data packages without a required Torch model stack; optional cloud/CUDA paths are described per command.",
    "torch": "Torch/model/research stack; CPU/CUDA/native requirements depend on the command and recipe.",
    "gui": "Interactive GUI dependencies in addition to the data stack."
  },
  "commands": [
    {
      "id": "commands",
      "summary": "Browse reviewed command families",
      "kind": "script",
      "argv": [
        "python",
        "scripts/list_commands.py"
      ],
      "source": "scripts/list_commands.py",
      "stack": "stdlib",
      "layout": "checkout",
      "villa": "none",
      "guide": "docs/COMMANDS.md",
      "needs": "Python 3.10; reads the bundled inventory only.",
      "effects": "observe"
    },
    {
      "id": "workspace-status",
