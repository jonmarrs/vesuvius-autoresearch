      "stack": "scientific",
      "layout": "checkout",
      "villa": "none",
      "guide": "CONTRIBUTING.md",
      "needs": "Python 3.10, pytest, NumPy and Ruff from requirements/ci-cpu.txt; Linux process tests.",
      "effects": "artifacts"
    },
    {
